<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="web_ban_hang2.SiteMaster" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title><%: Page.Title %></title>

    <link href="Content/bootstrap.min.css" rel="stylesheet" />
    <link href="Content/Site.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>

<form id="form1" runat="server">

    <!-- HEADER -->
    <header class="main-header">

        <div class="container header-container">

            <!-- LOGO -->
            <div class="logo">
                <a href="index.aspx">
                    SHOP MASTER
                </a>
            </div>

            <!-- SEARCH -->
            <div class="search-box">

                <asp:TextBox
                    ID="txtSearch"
                    runat="server"
                    CssClass="search-input"
                    placeholder="Tìm kiếm sản phẩm...">
                </asp:TextBox>

                <asp:Button
                    ID="btnSearch"
                    runat="server"
                    Text="Tìm kiếm"
                    CssClass="search-button" />

            </div>

            <!-- USER -->
            <div class="header-actions">

    <asp:Panel
        ID="pnlGuest"
        runat="server">

        <a href="Dang_nhap.aspx">
            Đăng nhập
        </a>

        <a href="Dang_ky.aspx">
            Đăng ký
        </a>

    </asp:Panel>


    <asp:Panel
        ID="pnlUser"
        runat="server"
        Visible="false">

        <span class="welcome-user">

            Xin chào,
            
            <asp:Label
                ID="lblUserName"
                runat="server">
            </asp:Label>

        </span>

        <a href="Dang_xuat.aspx">
            Đăng xuất
        </a>

    </asp:Panel>


    <a href="Cart.aspx"
       class="cart-link">

        🛒 Giỏ hàng

    </a>

</div>

        </div>

    </header>


    <!-- MENU -->
    <nav class="main-menu">

        <div class="container">

            <ul class="menu-list">

                <li>
                    <a href="index.aspx">
                        Trang chủ
                    </a>
                </li>

                <li>
                    <a href="shop.aspx">
                        Sản phẩm
                    </a>
                </li>

                <li>
                    <a href="#">
                        Danh mục
                    </a>
                </li>

                <li>
                    <a href="Contact.aspx">
                        Liên hệ
                    </a>
                </li>

            </ul>

        </div>

    </nav>


    <!-- MAIN CONTENT -->
    <main class="main-content">

        <div class="container">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

        </div>

    </main>


    <!-- FOOTER -->
    <footer class="main-footer">

        <div class="container footer-container">

            <div class="footer-column">

                <h3>SHOP MASTER</h3>

                <p>
                    Website bán hàng trực tuyến.
                </p>

                <p>
                    Cung cấp sản phẩm chất lượng
                    với giá tốt nhất.
                </p>

            </div>


            <div class="footer-column">

                <h3>Liên kết</h3>

                <a href="index.aspx">
                    Trang chủ
                </a>

                <a href="shop.aspx">
                    Sản phẩm
                </a>

                <a href="Cart.aspx">
                    Giỏ hàng
                </a>

                <a href="Contact.aspx">
                    Liên hệ
                </a>

            </div>


            <div class="footer-column">

                <h3>Liên hệ</h3>

                <p>Email: shop@gmail.com</p>

                <p>Điện thoại: 0123 456 789</p>

                <p>Hà Nội, Việt Nam</p>

            </div>

        </div>


        <div class="footer-bottom">

            © 2026 SHOP MASTER - All Rights Reserved

        </div>

    </footer>

</form>

</body>
</html>