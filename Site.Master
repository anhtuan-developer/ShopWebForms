<%@ Master Language="C#" AutoEventWireup="true"
CodeBehind="Site.Master.cs"
Inherits="web_ban_hang2.SiteMaster" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">

<head runat="server">

<meta charset="utf-8" />

<meta name="viewport"
      content="width=device-width, initial-scale=1.0" />

<meta name="description"
      content="SHOP 5 ANH EM - Website bán hàng trực tuyến" />

<title>
    <%: Page.Title %> - SHOP 5 ANH EM
</title>

<!-- =========================================================
     BOOTSTRAP 5
     ========================================================= -->

<link href="<%= ResolveUrl("~/Content/bootstrap.min.css") %>"
      rel="stylesheet" />


<link href="<%= ResolveUrl("~/Content/Site.css") %>"
      rel="stylesheet" />


<style>

    /* =====================================================
       HEADER
       ===================================================== */

    .shop-header {
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
    }

    .shop-logo {
        text-decoration: none;
        line-height: 1;
    }

    .shop-logo-main {
        display: block;
        font-size: 24px;
        font-weight: 800;
        color: #dc3545;
    }

    .shop-logo-sub {
        display: block;
        margin-top: 3px;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 2px;
        color: #6c757d;
    }


    /* =====================================================
       SEARCH
       ===================================================== */

    .shop-search {
        max-width: 650px;
        width: 100%;
    }

    .shop-search .form-control {
        border-right: 0;
    }

    .shop-search .btn {
        border-left: 0;
    }


    /* =====================================================
       USER ACTION
       ===================================================== */

    .shop-header-link {
        color: #343a40;
        text-decoration: none;
        white-space: nowrap;
    }

    .shop-header-link:hover {
        color: #dc3545;
    }


    /* =====================================================
       NAVBAR
       ===================================================== */

    .shop-navbar {
        background: #dc3545;
    }

    .shop-navbar .navbar-nav .nav-link {
        color: #ffffff;
        font-weight: 600;
        padding: 12px 16px;
    }

    .shop-navbar .navbar-nav .nav-link:hover,
    .shop-navbar .navbar-nav .nav-link:focus,
    .shop-navbar .navbar-nav .nav-link.active {
        background: rgba(255,255,255,.12);
        color: #ffffff;
    }


    /* =====================================================
       DANH MỤC BOOTSTRAP DROPDOWN
       ===================================================== */

    .category-dropdown-menu {
        min-width: 260px;
        padding: 8px 0;
        border: 0;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,.15);
    }

    .category-dropdown-title {
        padding: 10px 16px;
        font-size: 14px;
        font-weight: 700;
        color: #212529;
        border-bottom: 1px solid #eeeeee;
    }

    .category-dropdown-menu .dropdown-item {
        padding: 10px 16px;
        font-size: 14px;
    }

    .category-dropdown-menu .dropdown-item:hover,
    .category-dropdown-menu .dropdown-item:focus {
        background: #fff1f2;
        color: #dc3545;
    }


    /* =====================================================
       MAIN
       ===================================================== */

    .shop-main {
        min-height: 500px;
    }


    /* =====================================================
       FOOTER
       ===================================================== */

    .shop-footer {
        background: #212529;
        color: #adb5bd;
    }

    .shop-footer h5 {
        color: #ffffff;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .shop-footer a {
        color: #adb5bd;
        text-decoration: none;
    }

    .shop-footer a:hover {
        color: #ffffff;
    }

    .shop-footer-bottom {
        border-top: 1px solid rgba(255,255,255,.1);
    }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @media (max-width: 991.98px) {

        .shop-search {
            max-width: none;
        }

        .shop-header-actions {
            width: 100%;
        }

    }

</style>


<asp:ContentPlaceHolder
    ID="HeadContent"
    runat="server">
</asp:ContentPlaceHolder>


</head>

<body>

<form
    id="form1"
    runat="server">

<!-- =========================================================
     HEADER
     ========================================================= -->

<header class="shop-header">

    <div class="container py-3">

        <div class="row align-items-center g-3">


            <!-- =================================================
                 LOGO
                 ================================================= -->

            <div class="col-12 col-lg-3">

                <a
                    href="<%= ResolveUrl("~/index.aspx") %>"
                    class="shop-logo">

                    <span class="shop-logo-main">
                        SHOP
                    </span>

                    <span class="shop-logo-sub">
                        5 ANH EM
                    </span>

                </a>

            </div>


            <!-- =================================================
                 SEARCH
                 ================================================= -->

            <div class="col-12 col-lg-6">

                <div class="input-group shop-search mx-auto">

                    <asp:TextBox
                        ID="txtSearch"
                        runat="server"
                        CssClass="form-control"
                        placeholder="Tìm kiếm sản phẩm..."
                        aria-label="Tìm kiếm sản phẩm">
                    </asp:TextBox>

                    <asp:Button
                        ID="btnSearch"
                        runat="server"
                        Text="🔍"
                        CssClass="btn btn-danger px-4"
                        ToolTip="Tìm kiếm"
                        OnClick="btnSearch_Click" />

                </div>

            </div>


            <!-- =================================================
                 USER + CART
                 ================================================= -->

            <div class="col-12 col-lg-3">

                <div
                    class="d-flex justify-content-lg-end
                           justify-content-center
                           align-items-center
                           gap-3
                           shop-header-actions">


                    <!-- ===============================
                         KHÁCH
                         =============================== -->

                    <asp:Panel
                        ID="pnlGuest"
                        runat="server"
                        CssClass="d-flex align-items-center gap-2">

                        <a
                            href="<%= ResolveUrl("~/Dang_nhap.aspx") %>"
                            class="shop-header-link">

                            👤 Đăng nhập

                        </a>

                        <span class="text-secondary">
                            |
                        </span>

                        <a
                            href="<%= ResolveUrl("~/Dang_ky.aspx") %>"
                            class="shop-header-link">

                            Đăng ký

                        </a>

                    </asp:Panel>


                    <!-- ===============================
                         USER ĐÃ ĐĂNG NHẬP
                         =============================== -->

                    <asp:Panel
                        ID="pnlUser"
                        runat="server"
                        Visible="false"
                        CssClass="d-flex align-items-center gap-2 flex-wrap justify-content-center">

                        <span class="text-dark">

                            👤 Xin chào,

                            <strong>

                                <asp:Label
                                    ID="lblUserName"
                                    runat="server">
                                </asp:Label>

                            </strong>

                        </span>


                        <a
                            href="<%= ResolveUrl("~/DonHangCuaToi.aspx") %>"
                            class="shop-header-link">

                            Đơn hàng

                        </a>


                        <a
                            href="<%= ResolveUrl("~/Dang_xuat.aspx") %>"
                            class="shop-header-link text-danger">

                            Đăng xuất

                        </a>

                    </asp:Panel>


                    <!-- ===============================
                         GIỎ HÀNG
                         =============================== -->

                    <a
                        href="<%= ResolveUrl("~/Cart.aspx") %>"
                        class="btn btn-outline-danger">

                        🛒
                        <span class="d-none d-md-inline">
                            Giỏ hàng
                        </span>

                    </a>

                </div>

            </div>

        </div>

    </div>

</header>


<!-- =========================================================
     NAVBAR
     ========================================================= -->

<nav
    class="navbar navbar-expand-lg shop-navbar navbar-dark">

    <div class="container">


        <!-- MOBILE TOGGLE -->

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavbar"
            aria-controls="mainNavbar"
            aria-expanded="false"
            aria-label="Mở menu">

            <span class="navbar-toggler-icon"></span>

        </button>


        <!-- MENU -->

        <div
            class="collapse navbar-collapse"
            id="mainNavbar">

            <ul class="navbar-nav me-auto mb-2 mb-lg-0">


                <!-- ===============================
                     TRANG CHỦ
                     =============================== -->

                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="<%= ResolveUrl("~/index.aspx") %>">

                        🏠 Trang chủ

                    </a>

                </li>


                <!-- ===============================
                     SẢN PHẨM
                     =============================== -->

                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="<%= ResolveUrl("~/shop.aspx") %>">

                        🛍️ Sản phẩm

                    </a>

                </li>


                <!-- ===============================
                     DANH MỤC
                     =============================== -->

                <li class="nav-item dropdown">

                    <a
                        class="nav-link dropdown-toggle"
                        href="#"
                        id="categoryDropdown"
                        role="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">

                        📂 Danh mục

                    </a>


                    <ul
                        class="dropdown-menu
                               category-dropdown-menu"
                        aria-labelledby="categoryDropdown">


                        <!-- TIÊU ĐỀ -->

                        <li>

                            <div class="category-dropdown-title">

                                📂 Danh mục sản phẩm

                            </div>

                        </li>


                        <!-- TẤT CẢ -->

                        <li>

                            <a
                                class="dropdown-item"
                                href="<%= ResolveUrl("~/shop.aspx") %>">

                                🛍️ Tất cả sản phẩm

                            </a>

                        </li>


                        <!-- DANH MỤC DATABASE -->

                        <asp:Repeater
                            ID="rptDanhMuc"
                            runat="server">

                            <ItemTemplate>

                                <li>

                                    <a
                                        class="dropdown-item"
                                        href='<%#
                                            ResolveUrl(
                                                "~/shop.aspx?category="
                                                + Eval("MaDanhMuc")
                                            )
                                        %>'>

                                        📁
                                        <%# Eval("TenDanhMuc") %>

                                    </a>

                                </li>

                            </ItemTemplate>

                        </asp:Repeater>


                    </ul>

                </li>


                <!-- ===============================
                     TIN TỨC
                     =============================== -->

                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="<%= ResolveUrl("~/TinTuc.aspx") %>">

                        📰 Tin tức

                    </a>

                </li>


                <!-- ===============================
                     LIÊN HỆ
                     =============================== -->

                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="<%= ResolveUrl("~/Contact.aspx") %>">

                        📞 Liên hệ

                    </a>

                </li>

            </ul>

        </div>

    </div>

</nav>


<!-- =========================================================
     MAIN CONTENT
     ========================================================= -->

<main class="shop-main">

    <div class="container py-4">

        <asp:ContentPlaceHolder
            ID="MainContent"
            runat="server">
        </asp:ContentPlaceHolder>

    </div>

</main>


<!-- =========================================================
     FOOTER
     ========================================================= -->

<footer class="shop-footer">


    <div class="container py-5">

        <div class="row g-4">


            <!-- ===============================
                 SHOP
                 =============================== -->

            <div class="col-12 col-md-6 col-lg-3">

                <h5>
                    SHOP 5 ANH EM
                </h5>

                <p class="mb-3">

                    Website bán hàng trực tuyến
                    cung cấp các sản phẩm công nghệ
                    và phụ kiện chất lượng.

                </p>

                <div class="mb-2">
                    🚚 Giao hàng toàn quốc
                </div>

                <div class="mb-2">
                    🔒 Thanh toán an toàn
                </div>

                <div>
                    ⭐ Sản phẩm chất lượng
                </div>

            </div>


            <!-- ===============================
                 LIÊN KẾT
                 =============================== -->

            <div class="col-12 col-md-6 col-lg-3">

                <h5>
                    Liên kết nhanh
                </h5>

                <div class="d-flex flex-column gap-2">

                    <a href="<%= ResolveUrl("~/index.aspx") %>">
                        Trang chủ
                    </a>

                    <a href="<%= ResolveUrl("~/shop.aspx") %>">
                        Sản phẩm
                    </a>

                    <a href="<%= ResolveUrl("~/Cart.aspx") %>">
                        Giỏ hàng
                    </a>

                    <a href="<%= ResolveUrl("~/DonHangCuaToi.aspx") %>">
                        Đơn hàng của tôi
                    </a>

                    <a href="<%= ResolveUrl("~/TinTuc.aspx") %>">
                        Tin tức
                    </a>

                    <a href="<%= ResolveUrl("~/Contact.aspx") %>">
                        Liên hệ
                    </a>

                </div>

            </div>


            <!-- ===============================
                 HỖ TRỢ
                 =============================== -->

            <div class="col-12 col-md-6 col-lg-3">

                <h5>
                    Hỗ trợ khách hàng
                </h5>

                <div class="d-flex flex-column gap-2">

                    <a href="<%= ResolveUrl("~/Contact.aspx") %>">
                        Trung tâm hỗ trợ
                    </a>

                    <a href="<%= ResolveUrl("~/Contact.aspx") %>">
                        Chính sách giao hàng
                    </a>

                    <a href="<%= ResolveUrl("~/Contact.aspx") %>">
                        Chính sách đổi trả
                    </a>

                    <a href="<%= ResolveUrl("~/Contact.aspx") %>">
                        Chính sách bảo mật
                    </a>

                </div>

            </div>


            <!-- ===============================
                 LIÊN HỆ
                 =============================== -->

            <div class="col-12 col-md-6 col-lg-3">

                <h5>
                    Liên hệ
                </h5>

                <p class="mb-2">
                    📧 shop@gmail.com
                </p>

                <p class="mb-2">
                    📞 0123 456 789
                </p>

                <p class="mb-2">
                    📍 Hà Nội, Việt Nam
                </p>

                <p class="mb-0">
                    Facebook &nbsp; | &nbsp; Zalo
                </p>

            </div>

        </div>

    </div>


    <!-- ===============================
         FOOTER BOTTOM
         =============================== -->

    <div class="shop-footer-bottom">

        <div class="container py-3">

            <div
                class="d-flex
                       flex-column
                       flex-md-row
                       justify-content-between
                       align-items-center
                       gap-2">

                <span>
                    © 2026 SHOP 5 ANH EM
                </span>

                <span>
                    All Rights Reserved.
                </span>

            </div>

        </div>

    </div>

</footer>



<script src="<%= ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>">
</script>

</form>

</body>

</html>
