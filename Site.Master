<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="web_ban_hang2.SiteMaster" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">

<head runat="server">

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="SHOP 5 ANH EM - Website bán hàng trực tuyến" />

    <title>
        <%: Page.Title %> - SHOP 5 ANH EM
    </title>

    <!-- BOOTSTRAP -->
    <link href="<%= ResolveUrl("~/Content/bootstrap.min.css") %>"
          rel="stylesheet" />

    <!-- CSS WEBSITE -->
    <link href="<%= ResolveUrl("~/Content/Site.css") %>"
          rel="stylesheet" />

    <asp:ContentPlaceHolder
        ID="HeadContent"
        runat="server">
    </asp:ContentPlaceHolder>

</head>


<body>

<form
    id="form1"
    runat="server">


    <!-- ================================================= -->
    <!-- TOP BAR -->
    <!-- ================================================= -->

    <div class="top-bar">

        <div class="site-container top-bar-container">

            <div class="top-bar-left">

                <span>
                    🚚 Giao hàng toàn quốc
                </span>

                <span>
                    🔒 Thanh toán an toàn
                </span>

            </div>


            <div class="top-bar-right">

                <span>
                    📞 Hotline: 0123 456 789
                </span>

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <header class="main-header">

        <div class="site-container header-container">


            <!-- LOGO -->

            <div class="logo">

                <a href="<%= ResolveUrl("~/index.aspx") %>">

                    <span class="logo-main">
                        SHOP
                    </span>

                    <span class="logo-sub">
                        5 ANH EM
                    </span>

                </a>

            </div>


            <!-- SEARCH -->

            <div class="search-box">

                <asp:TextBox
                    ID="txtSearch"
                    runat="server"
                    CssClass="search-input"
                    placeholder="Tìm kiếm sản phẩm...">
                </asp:TextBox>


                <asp:Button
                    ID="btnSearch"
                    runat="server"
                    Text="🔍"
                    CssClass="search-button"
                    ToolTip="Tìm kiếm"
                    OnClick="btnSearch_Click" />

            </div>


            <!-- HEADER ACTIONS -->

            <div class="header-actions">


                <!-- KHÁCH -->

                <asp:Panel
                    ID="pnlGuest"
                    runat="server"
                    CssClass="user-actions">

                    <a href="<%= ResolveUrl("~/Dang_nhap.aspx") %>"
                       class="header-link">

                        <span class="header-icon">
                            👤
                        </span>

                        <span>
                            Đăng nhập
                        </span>

                    </a>


                    <a href="<%= ResolveUrl("~/Dang_ky.aspx") %>"
                       class="header-link header-register">

                        Đăng ký

                    </a>

                </asp:Panel>


                <!-- USER -->

                <asp:Panel
                    ID="pnlUser"
                    runat="server"
                    Visible="false"
                    CssClass="user-actions">


                    <div class="user-welcome">

                        <span class="header-icon">
                            👤
                        </span>

                        <span>

                            Xin chào,

                            <strong>
                                <asp:Label
                                    ID="lblUserName"
                                    runat="server">
                                </asp:Label>
                            </strong>

                        </span>

                    </div>


                    <a href="<%= ResolveUrl("~/DonHangCuaToi.aspx") %>"
                       class="header-link">

                        Đơn hàng

                    </a>


                    <a href="<%= ResolveUrl("~/Dang_xuat.aspx") %>"
                       class="header-link logout-link">

                        Đăng xuất

                    </a>

                </asp:Panel>


                <!-- CART -->

                <a href="<%= ResolveUrl("~/Cart.aspx") %>"
                   class="cart-link">

                    <span class="cart-icon">
                        🛒
                    </span>

                    <span>
                        Giỏ hàng
                    </span>

                </a>

            </div>

        </div>

    </header>


    <!-- ================================================= -->
    <!-- NAVIGATION -->
    <!-- ================================================= -->

    <nav class="main-menu">

        <div class="site-container">

            <ul class="menu-list">

                <li>
                    <a href="<%= ResolveUrl("~/index.aspx") %>">
                        🏠 Trang chủ
                    </a>
                </li>


                <li>
                    <a href="<%= ResolveUrl("~/shop.aspx") %>">
                        🛍️ Sản phẩm
                    </a>
                </li>


                <li>
                    <a href="<%= ResolveUrl("~/shop.aspx") %>">
                        📂 Danh mục
                    </a>
                </li>


                <li>
                    <a href="<%= ResolveUrl("~/TinTuc.aspx") %>">
                        📰 Tin tức
                    </a>
                </li>


                <li>
                    <a href="<%= ResolveUrl("~/Contact.aspx") %>">
                        📞 Liên hệ
                    </a>
                </li>

            </ul>

        </div>

    </nav>


    <!-- ================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ================================================= -->

    <main class="main-content">

        <div class="site-container">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

        </div>

    </main>


    <!-- ================================================= -->
    <!-- FOOTER -->
    <!-- ================================================= -->

    <footer class="main-footer">

        <div class="site-container footer-container">


            <!-- SHOP -->

            <div class="footer-column footer-brand">

                <div class="footer-logo">
                    SHOP 5 ANH EM
                </div>

                <p>
                    Website bán hàng trực tuyến
                    cung cấp các sản phẩm công nghệ
                    và phụ kiện chất lượng.
                </p>


                <div class="footer-feature">
                    🚚 Giao hàng toàn quốc
                </div>

                <div class="footer-feature">
                    🔒 Thanh toán an toàn
                </div>

                <div class="footer-feature">
                    ⭐ Sản phẩm chất lượng
                </div>

            </div>


            <!-- LIÊN KẾT -->

            <div class="footer-column">

                <h3>
                    Liên kết nhanh
                </h3>

                <a href="<%= ResolveUrl("~/index.aspx") %>">
                    Trang chủ
                </a>

                <a href="<%= ResolveUrl("~/shop.aspx") %>">
                    Sản phẩm
                </a>

                <a href="<%= ResolveUrl("~/Cart.aspx") %>">
                    Giỏ hàng
                </a>

                <a href="<%= ResolveUrl("~/DonHangCuaToi.aspx") %>">
                    Đơn hàng của tôi
                </a>

                <a href="<%= ResolveUrl("~/TinTuc.aspx") %>">
                    Tin tức
                </a>

                <a href="<%= ResolveUrl("~/Contact.aspx") %>">
                    Liên hệ
                </a>

            </div>


            <!-- HỖ TRỢ -->

            <div class="footer-column">

                <h3>
                    Hỗ trợ khách hàng
                </h3>

                <a href="<%= ResolveUrl("~/Contact.aspx") %>">
                    Trung tâm hỗ trợ
                </a>

                <a href="<%= ResolveUrl("~/Contact.aspx") %>">
                    Chính sách giao hàng
                </a>

                <a href="<%= ResolveUrl("~/Contact.aspx") %>">
                    Chính sách đổi trả
                </a>

                <a href="<%= ResolveUrl("~/Contact.aspx") %>">
                    Chính sách bảo mật
                </a>

            </div>


            <!-- LIÊN HỆ -->

            <div class="footer-column">

                <h3>
                    Liên hệ
                </h3>

                <p>
                    📧 shop@gmail.com
                </p>

                <p>
                    📞 0123 456 789
                </p>

                <p>
                    📍 Hà Nội, Việt Nam
                </p>

                <div class="footer-social">
                    Facebook &nbsp; | &nbsp; Zalo
                </div>

            </div>

        </div>


        <!-- FOOTER BOTTOM -->

        <div class="footer-bottom">

            <div class="site-container">

                <span>
                    © 2026 SHOP 5 ANH EM
                </span>

                <span>
                    All Rights Reserved.
                </span>

            </div>

        </div>

    </footer>


</form>


</body>

</html>

